<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Preetiz PreeScholar - AdminPanel</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', Arial, sans-serif;
      background: #f4f6f8;
    }

    .navbar {
      background: #359afe;
      color: white;
      padding: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .navbar h2 {
      margin: 0;
      font-size: 20px;
      font-weight: bold;
    }

    .navbar span {
      font-size: 14px;
      font-style: italic;
      color: #f1c40f;
      margin-left: 10px;
    }

    .container {
      padding: 20px;
      max-width: 1200px;
      margin: auto;
    }

    .card {
      background: white;
      padding: 20px;
      border-radius: 4px; /* less rounded, more rectangular */
      margin-bottom: 20px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

    input, select {
      width: 100%;
      padding: 10px;
      margin: 8px 0;
      border-radius: 4px;
      border: 1px solid #ccc;
    }

    button {
      padding: 10px 15px;
      background: #2e95fc;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      transition: background 0.3s ease;
    }

    button:hover {
      background: #4399e9;
    }

    .logout {
      background: #e74c3c;
    }

    .logout:hover {
      background: #c0392b;
    }

    .row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }

    @media(max-width: 768px) {
      .navbar h2 {
        font-size: 16px;
      }
    }
  </style>
</head>

<body>

  <div class="navbar">
    <h2>Preetiz PreeScholar - AdminPanel <span>(SakshamBharat)</span></h2>

    <form action="/logout" method="GET">
      <button class="logout">Logout</button>
    </form>
  </div>

  <div class="container">

    <!-- Upload PDF Card -->
    <div class="card">
      <h3>Upload PDF</h3>

      <form action="/pdf/upload" method="POST" enctype="multipart/form-data">

        <input type="text" name="subjectName" placeholder="Subject Name" required />

        <input type="text" name="subjectCode" placeholder="Subject Code" required />

        <select name="type" required>
          <option value="pyq">PYQ</option>
          <option value="important">Important Questions</option>
        </select>

        <input type="file" name="file" accept="application/pdf" required />

        <button type="submit">Upload</button>
      </form>
    </div>

    <!-- Quick Actions -->
    <div class="card">
      <h3>Quick Actions</h3>

      <div class="row">
        <form action="/pdf" method="GET">
          <input type="hidden" name="type" value="pyq">
          <button type="submit">View PYQs</button>
        </form>

        <form action="/pdf" method="GET">
          <input type="hidden" name="type" value="important">
          <button type="submit">View Important</button>
        </form>
      </div>
    </div>

  </div>

</body>
</html>
